  "scripts": {
    "prepare": "husky",
    "analyze:bundle:experimental": "pnpm next experimental-analyze",
    "analyze:bundle": "ANALYZE=true pnpm build",
    "dev": "next dev --turbopack",
    "dev:local": "dotenv -e .env.localhost next dev",
    "dev:staging": "dotenv -e .env.staging next dev",
    "dev:production": "dotenv -e .env.production next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 next build --turbopack",
    "api": "./gen-api.sh",
    "gen:ondo-denylist": "node ./gen-ondo-denylist.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint_es": "eslint . --ext .ts,.tsx,.js,.jsx",
    "preview": "next preview",
    "clean": "rm -rf ./tsconfig.tsbuildinfo",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "tsc:tests": "tsc --noEmit -p ./tests/tsconfig.json",
    "dupcheck:tests": "npx jscpd tests/e2e --min-lines 5 --min-tokens 50 --ignore 'tests/e2e/wallet/**'",
    "fix:staged-files": "lint-staged --allow-empty",
    "fix:all-files": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "pre-commit": "lint-staged",
    "i18next-resources-for-ts": "i18next-resources-for-ts interface -i ./src/i18n/translations/en -o ./src/i18n/resources.d.ts",
    "test": "pnpm exec playwright test",
    "test:perf:cold-lcp": "pnpm exec playwright test -c playwright.perf.config.ts",
    "test:install": "pnpm exec playwright install",
    "test:qase": "QASE_MODE=testops pnpm test",
    "test:e2e-real": "npx playwright test --headed",
    "test:ci:e2e": "npx playwright test",
    "test:ci:e2e:qase": "QASE_MODE=testops npx playwright test",
    "test:unit": "vitest run --project=unit",
    "test:unit-components": "vitest run --project=unit-components",
    "test:snapshots": "vitest run --project=snapshots",
    "test:snapshots:generate": "vitest run --project=snapshots -u",
    "test:storybook": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "debug": "NODE_OPTIONS='--inspect' next dev"
  },
  "lint-staged": {
    "**/*.(ts|tsx|js|mjs)": [
      "bash -c tsc --noEmit",
      "pnpm eslint --fix",
      "pnpm prettier --write"
    ],
    "**/*.(md|json)": [
      "pnpm prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10"
      }
    },
    "overrides": {
      "@safe-global/safe-apps-provider": ">=0.18.6",
      "hono": "^4.12.7",
      "systeminformation": "^5.31.6"
    },
    "onlyBuiltDependencies": [
      "@reown/appkit",
      "@sentry/cli",
      "@swc/core",
      "bigint-buffer",
      "bufferutil",
      "core-js-pure",
      "esbuild",
      "keccak",
      "secp256k1",
      "sharp",
      "sleep",
      "unrs-resolver",
      "utf-8-validate"
    ]
  },
  "packageManager": "pnpm@10.33.4"
}
